# 환경 변수
.env
*.env
.env.local
mcp_agent.config.yaml
mcp_agent.secrets.yaml
config.py

# IntelliJ IDEA project files
.idea/

# trading/.gitignore
trading/config/KIS*
trading/config/*.token*
trading/config/*.key
trading/config/kis_devlp.yaml
trading/config/kis_*.yaml

# examples/.gitignore
examples/dashboard/build/
examples/dashboard/dist/
examples/dashboard/node_modules/

# Python 캐시 및 로그
__pycache__/
*.pyc
*.pyo
*.log
*.log.*
ai_bot_*.log

# 로그 디렉토리 (gitkeep만 추적)
logs/*
!logs/.gitkeep

# 보고서 디렉토리 (테스트로 생성된 파일 제외)
reports/*
!reports/.gitkeep
html_reports/*
!html_reports/.gitkeep